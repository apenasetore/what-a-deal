# Credenciais do Gmail para o MS Notificacao (envio de email de hot deals).
#
# Copie este arquivo para `.env` e preencha com seus dados:
#   cp .env.example .env
#
#
# GMAIL_USER          = seu email completo do Gmail
# GMAIL_APP_PASSWORD  = App Password de 16 chars (gerado em
#                       https://myaccount.google.com/apppasswords com a
#                       verificacao em 2 etapas ativa). NAO e a senha de login.

GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
